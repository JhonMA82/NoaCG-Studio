{
  "language": {
    "version": 1,
    "name": "Aldervale Keynote",
    "rationale": "This design language reflects The Aldervale Institute's measured and scholarly character, using a restrained palette and precise typography to convey quiet authority suitable for a corporate keynote.",
    "palette": {
      "accent": "#b99a5b",
      "panel": "#f2ede4",
      "text": "#14264a",
      "textDim": "#45526b"
    },
    "typography": {
      "fontId": "source-serif-4",
      "headingWeight": "semibold",
      "supportingWeight": "regular",
      "step": "clear",
      "headingCase": "as-written",
      "supportingCase": "as-written",
      "tracking": "tight"
    },
    "shape": {
      "corner": "sharp",
      "panel": "solid"
    },
    "accent": {
      "form": "top-rule",
      "weight": "hairline"
    },
    "density": "compact",
    "motion": {
      "character": "glide",
      "pace": "measured"
    }
  },
  "fallbacks": [],
  "adjustments": [],
  "notes": [
    "structure and spacing: platform-owned (compact density - 18/25px padding, 8px line gap, at scale 1)",
    "accent: a rule across the top of the panel, one clear space above the words",
    "surface: a solid surface",
    "motion: glide at measured pace → preset mask-wipe"
  ],
  "spacing": {
    "headingPx": 54,
    "supportingPx": 26,
    "padVPx": 18,
    "padHPx": 25,
    "lineGapPx": 8,
    "accentPx": 3,
    "ruleGapPx": 24,
    "cornerPx": 0,
    "markHeightPx": 65,
    "markGapPx": 26,
    "headingWeight": 600,
    "supportingWeight": 500,
    "headingTracking": "-0.02em",
    "supportingTracking": "0.04em",
    "preset": "mask-wipe",
    "speed": 1
  }
}
