{
  // The api/ typecheck in `npm run build`.
  //
  // `lib` is ES2020, NOT ES2022, and deliberately lower than the ES2022 target. Vercel does
  // not use this file when it compiles the serverless functions - it uses the ROOT
  // tsconfig.json, whose lib is ES2020. So an ES2021+ library API (`.at()`, `Object.hasOwn`,
  // `Array.findLast`, `structuredClone`) typechecks perfectly here and then fails the
  // PRODUCTION build with TS2550, where nothing local can see it.
  //
  // That is not hypothetical: `id.split('/').at(-1)` shipped in d512f6e and every production
  // deployment failed from then until it was found, while `npm run build` stayed green the
  // whole time. Pinning lib to what Vercel actually allows makes this gate reproduce the
  // production build instead of being more permissive than it.
  //
  // `target` stays ES2022 because the functions run on Node 24 - only the TYPE surface is
  // constrained, never the emitted syntax (this config is noEmit anyway).
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["api"]
}
