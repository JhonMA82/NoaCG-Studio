{
  "name": "noacg-studio",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "type": "module",
  "description": "NoaCG Studio — a modern, premium broadcast graphics builder. Create on-air templates and export SPX / CasparCG / OGraf.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:bench": "node scripts/dev-bench.mjs",
    "build": "node scripts/check-shared-instructions.mjs && node --test scripts/worktree-safety.test.mjs scripts/merge-order.test.mjs scripts/hooks/stop-next.test.mjs && node scripts/run-ai-gateway-tests.mjs && node --test scripts/ai-serverless-runtime.test.mjs scripts/ai-lite-migration.test.mjs scripts/admin-security-migration.test.mjs scripts/ai-lite-bench.test.mjs scripts/video-benchmark-scoring.test.mjs scripts/ai-vision-scoring.test.mjs scripts/prerender.test.mjs && node scripts/check-client-secrets.mjs && node scripts/build-player-host.mjs && tsc && tsc -p tsconfig.api.json && eslint . --max-warnings 0 && depcruise --config .dependency-cruiser.cjs src && vite build && node scripts/prerender.mjs && node scripts/write-version.mjs && node scripts/check-client-secrets.mjs dist",
    "build:player-host": "node scripts/build-player-host.mjs --force",
    "check:shared-instructions": "node scripts/check-shared-instructions.mjs",
    "check:vendored": "node scripts/check-vendored-versions.mjs",
    "check:models": "node scripts/check-model-ids.mjs",
    "check:advisors": "node scripts/supabase-advisors.mjs",
    "check:freshness": "node scripts/check-vendored-versions.mjs && node scripts/check-model-ids.mjs",
    "lint": "eslint . --max-warnings 0",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:affected": "node scripts/e2e-affected.mjs",
    "test:e2e:catalog": "playwright test --config=playwright.catalog.config.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:ports": "node --test scripts/port-registry.test.mjs",
    "test:worktree-safety": "node --test scripts/worktree-safety.test.mjs",
    "test:local-relay": "node --test scripts/local-relay.test.mjs",
    "test:merge-order": "node --test scripts/merge-order.test.mjs",
    "test:stop-next-hook": "node --test scripts/hooks/stop-next.test.mjs",
    "test:prerender": "node --test scripts/prerender.test.mjs",
    "test:admin-security": "node --test scripts/admin-security-migration.test.mjs",
    "test:ai-gateway": "node scripts/run-ai-gateway-tests.mjs",
    "test:ai-serverless-runtime": "node --test scripts/ai-serverless-runtime.test.mjs",
    "eval:ai-lite": "node scripts/ai-lite-eval.mjs",
    "bench:calibrate": "node scripts/ai-lite-calibrate.mjs",
    "bench:preflight": "node scripts/ai-bench-preflight.mjs",
    "bench:discover": "node scripts/ai-lite-discover.mjs",
    "bench:qualify": "node scripts/ai-lite-qualify.mjs",
    "bench:compare": "node scripts/ai-lite-compare.mjs",
    "bench:vision:dataset": "node scripts/ai-vision-dataset.mjs",
    "bench:vision:hostile": "node scripts/ai-vision-hostile.mjs",
    "bench:vision": "node scripts/ai-vision-run.mjs",
    "bench:harness": "node scripts/ai-bench-compare.mjs",
    "bench:regress": "node scripts/ai-lite-regress.mjs",
    "bench:lite": "node scripts/ai-lite-eval.mjs",
    "bench:spike": "node scripts/ai-lite-spike.mjs",
    "bench:gallery": "node scripts/ai-lite-gallery.mjs",
    "bench:sameness": "node scripts/ai-lite-sameness.mjs",
    "bench:creative:route": "node scripts/creative-route-bench.mjs",
    "bench:creative:pilot": "node scripts/creative-pilot-bench.mjs",
    "bench:creative:refs": "node scripts/creative-catalog-refs.mjs",
    "bench:report": "node scripts/ai-lite-report.mjs",
    "bench:pro": "node scripts/pro-bench.mjs",
    "video:models:sync": "node scripts/video-models-sync.mjs",
    "video:bench:smoke": "node scripts/video-benchmark.mjs smoke",
    "video:bench:run": "node scripts/video-benchmark.mjs run",
    "video:bench:report": "node scripts/video-benchmark-report.mjs",
    "test:ai-lite-bench": "node --test scripts/ai-lite-bench.test.mjs",
    "postinstall": "node scripts/dev-port.mjs && node scripts/gen-video-font-css.mjs && node scripts/build-player-host.mjs"
  },
  "overrides": {
    "dompurify": "3.4.13"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@remotion/vercel": "^4.0.488",
    "@supabase/supabase-js": "^2.110.2",
    "@vercel/functions": "^3.7.5",
    "@vercel/sandbox": "1.6.0",
    "file-saver": "^2.0.5",
    "jszip": "^3.10.1",
    "monaco-editor": "^0.56.0",
    "prettier": "^3.9.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sucrase": "^3.35.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@emnapi/core": "^1.11.2",
    "@emnapi/runtime": "^1.11.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "dependency-cruiser": "^18.1.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4"
  }
}
