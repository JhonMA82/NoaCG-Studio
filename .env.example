# Copy this file to .env (which is gitignored) and fill in what you use.
# Provider and model are non-secret browser preferences. Keys below are server-only.
VITE_AI_PROVIDER=anthropic
VITE_AI_MODEL=
# Optional ordered fallback routes. This is the explicit authorization boundary: when
# empty, a request never changes provider/model after failure.
# VITE_AI_FALLBACKS=[{"provider":"openai","model":"example-model"}]
VITE_AI_FALLBACKS=

# AI provider keys - server-only. Never use a VITE_ prefix and never commit real values.
# Configure any subset; a route needs either its managed key or a securely stored user key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Hugging Face Inference Providers. HUGGINGFACE_API_KEY is preferred; HF_TOKEN is accepted
# for compatibility with Hugging Face tooling.
HUGGINGFACE_API_KEY=
HF_TOKEN=

# Required to accept optional user-provided keys. Use a unique random value of at least
# 32 characters. Keys are sealed in an authenticated HttpOnly cookie and never enter
# browser-readable storage, client bundles, logs, or error messages.
AI_KEY_ENCRYPTION_SECRET=

# Provider-call bounds. Defaults are 120000 ms and one retry.
AI_TIMEOUT_MS=120000
AI_RETRY_LIMIT=1

# Per-IP burst gate on /api/ai/generate (BYO-key traffic included). Defaults are a
# 60-second window and 60 requests per window; 0 disables the gate.
AI_GENERATE_RATE_WINDOW_SEC=60
AI_GENERATE_RATE_MAX=60

# Optional JSON keyed by "provider:model". Values are USD per million tokens and produce
# estimate metadata only. Omit an entry rather than publishing a stale estimate.
# Example with illustrative zero values, not real pricing:
# AI_MODEL_PRICING_JSON={"openai:example-model":{"inputPerMillion":0,"outputPerMillion":0}}
AI_MODEL_PRICING_JSON=

# Public deployment URL sent only as OpenRouter attribution metadata.
PUBLIC_APP_URL=

# NoaCG Lite - managed, server-owned Creative AI profile. Disabled unless explicitly enabled.
# Exact model routes and provider names never enter the product UI. OpenRouter routes fail
# closed unless an audited provider endpoint allowlist is configured. Every managed route
# (primary, fallback, judge) must also be an entry in the server approved-route catalog
# (api/_lib/aiModelCatalog.ts, docs/AI_TASK_REGISTRY.md) - AI_LITE_PRICING_JSON can adjust
# a price but cannot approve a new route.
AI_LITE_ENABLED=0
AI_LITE_PRIMARY_PROVIDER=openrouter
AI_LITE_PRIMARY_MODEL=google/gemini-2.5-flash-lite
AI_LITE_FALLBACK_PROVIDER=openrouter
AI_LITE_FALLBACK_MODEL=qwen/qwen3-coder-next
# Comma-separated OpenRouter provider slugs reviewed for retention, training, ZDR, region,
# and structured-output support. Do not enable Lite with an empty list.
AI_LITE_OPENROUTER_PROVIDERS=
# ZDR remains the safe default. Set to 0 only for an audited no-training route after the
# Lite first-use retention notice is deployed. This setting is server-only.
AI_LITE_REQUIRE_ZDR=1
# Use "tool" only for an audited model that supports forced tools but not JSON Schema output.
AI_LITE_OPENROUTER_STRUCTURED_MODE=json-schema
AI_LITE_PROMPT_VERSION=lite-lower-third-v3
# Current server-reviewed USD prices per million tokens, keyed by "provider:model".
# A route without a price entry fails closed instead of making an unbounded request.
# AI_LITE_PRICING_JSON={"openrouter:vendor/model":{"inputPerMillion":0.1,"outputPerMillion":0.4}}
AI_LITE_PRICING_JSON=
AI_LITE_MAX_COST_USD=0.007
AI_LITE_DAILY_SUCCESSES=3
AI_LITE_MONTHLY_SUCCESSES=20
AI_LITE_DAILY_STARTS=6
AI_LITE_MONTHLY_STARTS=30
AI_LITE_USER_CONCURRENCY=1
AI_LITE_FLEET_CONCURRENCY=20
AI_LITE_FLEET_DAILY_SPEND_USD=25
AI_LITE_PROMPT_CHARACTERS=2000
AI_LITE_CONVERSATION_TURNS=6
AI_LITE_CONVERSATION_CHARACTERS=6000
AI_LITE_FIELDS=2
AI_LITE_LOGO_BYTES=2000000
AI_LITE_MAX_INPUT_TOKENS=12000
AI_LITE_OUTPUT_TOKENS=1500
AI_LITE_REPAIR_OUTPUT_TOKENS=1000
AI_LITE_TIMEOUT_MS=30000
AI_LITE_EXPIRY_MINUTES=15
# The SKIN experiment: the one Lite call may also return bounded restyling CSS for the
# neutral Skin Canvas chassis. Off = byte-identical prompt/schema; a skin a model emits
# anyway is stripped server-side. Skin-enabled routes need the larger output budget
# (AI_LITE_OUTPUT_TOKENS defaults to 3500 when this is on).
AI_LITE_SKIN_ENABLED=0
# The skin VISION JUDGE: one server-owned, cost-capped vision call scoring the rendered
# hold frame (legibility/hierarchy/brief-fit/strap-shape); below the threshold the caller
# reverts to the house chassis. Fails closed like the generation routes: the judge model
# needs a price entry and, on OpenRouter, the same audited provider allowlist.
AI_LITE_JUDGE_ENABLED=0
AI_LITE_JUDGE_PROVIDER=openrouter
AI_LITE_JUDGE_MODEL=google/gemini-2.5-flash
AI_LITE_JUDGE_MAX_COST_USD=0.004
AI_LITE_JUDGE_OUTPUT_TOKENS=400
AI_LITE_JUDGE_INPUT_TOKENS=4000
# How many judgements ONE generation may book (attempts, not successes - one judgement
# plus room for two transient provider retries). Without a cap, a single generation id
# the caller owns is an unbounded handle on the judge's spend.
AI_LITE_JUDGE_MAX_PER_GENERATION=3
# Minimum every judge axis must reach for a pass (1-5). Calibrate against blind review
# (docs/AI_LITE_BENCHMARK.md) before trusting it anywhere near production.
AI_LITE_JUDGE_THRESHOLD=3
# Aggregate accepted/discarded chassis outcomes become a subtle routing prior only
# after this content-free sample threshold, looking back over this many days.
AI_LITE_PRIOR_MIN_SAMPLES=8
AI_LITE_PRIOR_WINDOW_DAYS=90
# Comma-separated authenticated Supabase user ids with expanded development/evaluation
# allowances. This is server-only and cannot be enabled by query parameters or localStorage.
AI_LITE_OVERRIDE_USER_IDS=
# Local benchmark only. Uses an in-process ledger when not running in production or Vercel.
# Never configure this on a deployed instance.
AI_LITE_EVAL_MEMORY_LEDGER=0

# ── Supabase backend (Era 5) — all OPTIONAL. Leave blank to run in pure offline mode ──
# (no login, no cloud sync, exports unchanged — exactly the self-hostable offline tool).
# The anon key is PUBLIC (Row Level Security is the real boundary) so it is safe to ship in the
# client bundle. NEVER put the service_role key here or in any VITE_-prefixed var — those are
# bundled into the browser. Server secrets belong in the private deployment's secret store.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Note: there is no "require auth" switch. With a backend configured, the editor is still open to
# everyone — signing in only unlocks the account features (cloud sync, community, AI).

# ── Configured-mode E2E (npm run test:e2e:live) — OPTIONAL, maintainer-only ──────────────────────
# A THROWAWAY test account (email/password, allowlisted) used to exercise the authenticated community
# flows against the configured Supabase backend above. Leave blank and the live suite skips. These are
# NOT VITE_-prefixed, so they are never bundled into the client — point them at a test account on a
# test/staging project, never a production tenant with real users (the specs publish + delete rows).
E2E_EMAIL=
E2E_PASSWORD=
# Optional: the service_role key (server secret — NEVER a VITE_ var) enables the moderator spec, which
# needs to grant/revoke the test account's moderator role. Without it that spec skips.
SUPABASE_SERVICE_ROLE_KEY=

# ── Video/image rendering (Era 7) — all OPTIONAL; leave blank and the feature does not exist ────
# Client flag: shows the Export tab's "Video & image" section. Set on hosted deployments
# (and locally for the offline dev loop — rendering then runs on THIS machine).
VITE_RENDER_API=

# Server-only (Vercel project env / local .env for the dev-server api middleware — NEVER VITE_):
# 'sandbox' on Vercel (renders in Vercel Sandbox); unset/anything else = local child process.
RENDER_EXECUTOR=
# From the Vercel Blob store (Storage → Blob → connect). Holds finished renders until TTL.
BLOB_READ_WRITE_TOKEN=
# Bearer expected by the /api/render/cleanup cron (Vercel sends it automatically when set).
CRON_SECRET=
# Salts anonymous per-IP render quotas. Any long random string.
IP_HASH_SALT=
# The render_jobs ledger reuses VITE_SUPABASE_URL/VITE_SUPABASE_ANON_KEY plus a Supabase
# secret key. Prefer the new sb_secret_… secret key here; the legacy service_role JWT in
# SUPABASE_SERVICE_ROLE_KEY (above) is still accepted as a fallback. Without either, render
# jobs live in process memory (fine for the local dev loop).
SUPABASE_SECRET_KEY=
